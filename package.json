{
  "name": "reimburse",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/charts": "^1.2.13",
    "@ant-design/icons": "^4.6.3",
    "@ant-design/plots": "^1.2.5",
    "@lingui/react": "^3.14.0",
    "@mdi/js": "^5.9.55",
    "@mdi/react": "^1.4.0",
    "@types/react-slider": "^1.3.1",
    "antd": "^4.13.1",
    "axios": "^0.21.1",
    "babel-plugin-import": "^1.13.3",
    "big.js": "^6.0.3",
    "customize-cra": "^0.9.1",
    "express": "^4.17.1",
    "express-favicon": "^2.0.1",
    "js-file-download": "^0.4.12",
    "less": "^3.13.1",
    "less-loader": "^5.0.0",
    "lodash.clonedeep": "^4.5.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "papaparse": "^5.3.0",
    "qrcode.react": "^1.0.1",
    "react": "^16.14.0",
    "react-app-polyfill": "^2.0.0",
    "react-app-rewired": "^2.1.8",
    "react-countdown-circle-timer": "^2.5.4",
    "react-d3-tree": "^1.17.1",
    "react-dom": "^16.14.0",
    "react-google-autocomplete": "^2.4.0",
    "react-google-places-autocomplete": "^2.3.2",
    "react-idle-timer": "^4.5.6",
    "react-pdf": "^5.2.0",
    "react-quill": "^1.3.5",
    "react-redux": "^7.2.2",
    "react-router-dom": "^5.2.0",
    "react-scripts": "3.4.0",
    "react-slider": "^2.0.6",
    "react-to-print": "^2.14.7",
    "react-uuid": "^2.0.0",
    "react-virtualized": "^9.22.3",
    "redux": "^4.0.5",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.3.0",
    "retry-axios": "^2.4.0",
    "typescript": "^3.9.9"
  },
  "scripts": {
    "startProductionSAP": "REACT_APP_ENVIRONMENT=SAP_PRODUCTION node server.js",
    "buildProductionSAP": "REACT_APP_ENVIRONMENT=SAP_PRODUCTION react-app-rewired build",
    "startStagingSAP": "REACT_APP_ENVIRONMENT=SAP_STAGING node server.js",
    "buildStaging": "REACT_APP_ENVIRONMENT=SAP_STAGING react-app-rewired build",
    "start": "REACT_APP_ENVIRONMENT=DEVELOPMENT react-app-rewired start",
    "build": "REACT_APP_ENVIRONMENT=DEVELOPMENT react-app-rewired build",
    "build-qa": "REACT_APP_ENVIRONMENT=QA react-app-rewired build",
    "test": "REACT_APP_ENVIRONMENT=TEST react-app-rewired test",
    "defaultTest": "REACT_APP_ENVIRONMENT=TEST react-scripts test",
    "eject": "REACT_APP_ENVIRONMENT=SAP_PRODUCTION react-scripts eject",
    "start-local": "REACT_APP_ENVIRONMENT=LOCAL react-app-rewired start",
    "start-staging": "REACT_APP_ENVIRONMENT=SAP_PRODUCTION react-app-rewired start",
    "add-locale": "lingui add-locale --format minimal",
    "extract": "lingui extract",
    "compile": "lingui compile",
    "translate": "node translator.js",
    "cypress:dev-tesla-local": "cypress open --env server=development,url=http://localhost:3003,tenant=tesla",
    "cypress:dev-tesla": "cypress open --env server=development,url=https://dev.reimburse.digital,tenant=tesla",
    "cypress:headless": "cypress run --headless --browser chrome --config video=false chromeWebSecurity=false --spec cypress/integration/authentication/authentication.spec.js --env server=development,url=https://dev.reimburse.digital,tenant=tesla",
    "windows-start": "set 'REACT_APP_ENVIRONMENT=DEVELOPMENT' && react-app-rewired start",
    "lint": "eslint . --fix --max-warnings=10",
    "format": "prettier . --write",
    "prepare": "husky install",
    "test:nowatch": "react-scripts test --watchAll=false --passWithNoTests --updateSnapshot"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "ie 11"
    ],
    "development": [
      "ie 11",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.19.6",
    "@babel/preset-typescript": "^7.18.6",
    "@lingui/cli": "^3.14.0",
    "@lingui/core": "^3.14.0",
    "@lingui/macro": "^3.14.0",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^12.1.5",
    "@types/big.js": "^6.0.2",
    "@types/jest": "^25.2.3",
    "@types/lingui__core": "^2.7.1",
    "@types/lingui__macro": "^2.7.4",
    "@types/lingui__react": "^2.8.3",
    "@types/lodash.clonedeep": "^4.5.6",
    "@types/moment-timezone": "^0.5.30",
    "@types/node": "^12.20.5",
    "@types/papaparse": "^5.2.5",
    "@types/qrcode.react": "^1.0.2",
    "@types/react": "^16.14.5",
    "@types/react-dom": "^16.9.11",
    "@types/react-pdf": "^4.0.6",
    "@types/react-redux": "^7.1.16",
    "@types/react-router-dom": "^5.1.7",
    "@types/react-test-renderer": "^16.9.5",
    "@types/react-virtualized": "^9.21.11",
    "@types/redux-mock-store": "^1.0.3",
    "@types/testing-library__jest-dom": "^5.14.5",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^24.9.0",
    "babel-plugin-macros": "^3.1.0",
    "cypress": "^5.6.0",
    "cypress-file-upload": "^4.1.1",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "husky": "^8.0.1",
    "jest": "^24.9.0",
    "jest-enzyme": "^7.1.2",
    "lint-staged": "^13.0.3",
    "prettier": "^1.19.1",
    "react-test-renderer": "^16.14.0",
    "redux-devtools-extension": "^2.13.9",
    "redux-mock-store": "^1.5.4",
    "translation-google": "^0.2.1",
    "ts-jest": "^24.3.0"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx$": "ts-jest",
      "^.+\\.ts$": "ts-jest",
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ]
  },
  "transformIgnorePatterns": [
    "<rootDir>/node_modules/(?!(quill-mention)/)"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,html,json}": [
      "npm run format"
    ]
  }
}
